# Stub runs on your machine with a stand-in for Kinde when PROVIDER is empty or "standin".
# Copy this file to .env.local to change a value. Bun reads .env.local on start.

PORT=3100

# standin (default) or kinde
PROVIDER=standin
# How long each stand-in lookup takes, in milliseconds. This is a number you choose, not a measurement of Kinde.
PROVIDER_DELAY_MS=150

# Gate mode: cache (default), always (a lookup on every request), none (skip the check)
MODE=cache
# An answer is used as it is for FRESH_MS, then served while a refresh runs until STALE_OK_MS.
FRESH_MS=30000
STALE_OK_MS=300000
# A lookup that takes longer than this counts as a failure.
TIMEOUT_MS=1500

# Needed for PROVIDER=kinde
KINDE_DOMAIN=https://yourbusiness.kinde.com
# Set an audience only if your API in Kinde uses one. Tokens are always checked for the issuer.
AUDIENCE=
# A machine-to-machine app with the read:billing_entitlements scope
KINDE_M2M_CLIENT_ID=
KINDE_M2M_CLIENT_SECRET=
# A JSON file that maps each organization code to its Kinde billing customer ID. See customers.example.json.
CUSTOMERS_FILE=customers.json
